# FindIt AI Environment Variables Configuration

# MongoDB Persistence
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=findit_ai

# Google Gemini Multimodal GenAI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Semantic Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security & Authentication
JWT_SECRET_KEY=generate_a_secure_random_64_character_hex_secret_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Campus Email Domain Rules (* allows any domain during development, or comma-separated e.g. college.edu,student.univ.ac.in)
COLLEGE_EMAIL_DOMAINS=*

# Client & Server Addresses
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# Cloud Storage (Optional - Defaults to local storage in ./uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
